# Copy to .env and fill in. Never commit .env.
# Claude is only used when the app runs on your own computer (Explore mode, and the build script).
# The deployed site never calls Claude, so do not add this key to Vercel.
ANTHROPIC_API_KEY=
# Optional: override the model (default claude-opus-5-5)
# MIND_PALACE_MODEL=claude-opus-5-5

# --- Study sessions in MongoDB (optional) ---
# Without MONGODB_URI the study still runs, but each session stays in the browser that ran it.
# Connection string from MongoDB Atlas (Database > Connect > Drivers), with the password filled in:
MONGODB_URI=
# Database name (default mind_palace)
# MONGODB_DB=mind_palace
# Password for the researcher page (/?study=admin). Use a long random one, e.g. `openssl rand -base64 24`.
STUDY_ADMIN_KEY=
