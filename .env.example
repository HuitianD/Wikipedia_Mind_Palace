# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
# Optional: override the model (default claude-opus-5-5)
# MIND_PALACE_MODEL=claude-opus-5-5

# --- Study sessions in MongoDB (optional) ---
# Without MONGODB_URI the study still runs, but each session stays in the browser that ran it.
# Connection string from MongoDB Atlas (Database > Connect > Drivers), with the password filled in:
MONGODB_URI=
# Database name (default mind_palace)
# MONGODB_DB=mind_palace
# Password for the researcher page (/?study=admin). Use a long random one, e.g. `openssl rand -base64 24`.
STUDY_ADMIN_KEY=

# --- Who can use Claude (optional locally, needed on a public site) ---
# OAuth client ID from the Google Cloud console (APIs & Services > Credentials > OAuth client ID > Web application).
# When set, only signed-in people get Claude's suggestions. Without it, Claude is open on your own
# computer and switched off on Vercel.
GOOGLE_CLIENT_ID=
# Who may sign in (default brown.edu), and extra single addresses outside those domains
# ALLOWED_EMAIL_DOMAINS=brown.edu
# ALLOWED_EMAILS=
# Claude requests per person per day (default 10)
# SUGGEST_DAILY_LIMIT=10
