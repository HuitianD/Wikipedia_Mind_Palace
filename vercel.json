{
  "functions": {
    "api/study.js": {
      "includeFiles": "data/**"
    }
  },
  "redirects": [
    {
      "source": "/lib/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/scripts/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/server.mjs",
      "destination": "/",
      "permanent": false
    }
  ]
}
